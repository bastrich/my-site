{
  "name": "bastrich-tech",
  "main": "infra/cloudflare/worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
